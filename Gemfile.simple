source 'https://rubygems.org'

# Core Jekyll
gem 'jekyll', '~> 4.0'
gem 'webrick', '~> 1.7'

# Essential plugins only
gem 'jekyll-feed'
gem 'jekyll-sitemap'
gem 'jekyll-paginate-v2'
gem 'jekyll-archives'
gem 'jekyll-toc'

# For academic features
gem 'jekyll-scholar'

# Basic theme support
gem 'kramdown-parser-gfm'

# For external posts plugin
gem 'feedjira'
gem 'httparty' 