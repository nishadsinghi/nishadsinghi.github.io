source 'https://rubygems.org'

# Core Jekyll
gem 'jekyll', '~> 4.0'
gem 'webrick', '~> 1.7'

# Essential plugins
gem 'jekyll-feed'
gem 'jekyll-sitemap'
gem 'jekyll-paginate-v2'
gem 'jekyll-archives'
gem 'jekyll-toc'
gem 'jekyll-email-protect'

# Academic features
gem 'jekyll-scholar'

# External content
gem 'feedjira'
gem 'httparty'

# Theme support
gem 'kramdown-parser-gfm'

# Optional: Add these if you want more features
# gem 'jekyll-twitter-plugin'  # For Twitter integration
# gem 'jekyll-diagrams'        # For diagrams (may need additional dependencies)
# gem 'jemoji'                 # For emoji support 